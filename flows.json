    {
        "id": "21293fb28fbf9f8a",
        "type": "function",
        "z": "c2e9e564fd169a4f",
        "name": "Buffer 599 Samples",
        "func": "let buffer = flow.get(\"buffer\") || [];\n\n\n// Convert JSON string to object\nlet data = JSON.parse(msg.payload);\n\n\nlet power = Number(data.total_power);\n\n\nnode.warn(\"POWER = \" + power);\n\n\nif (isNaN(power)) {\n    node.warn(\"POWER INVALID\");\n    return null;\n}\n\n\n// Save original sensor data\nmsg.original_payload = {\n    voltage: Number(data.voltage) || 0,\n    current: Number(data.current) || 0,\n    total_power: Number(data.total_power) || 0,\n    relay_lamp: Number(data.relay_lamp) || 0,\n    relay_laptop: Number(data.relay_laptop) || 0,\n    relay_kettle: Number(data.relay_kettle) || 0,\n    relay_toaster: Number(data.relay_toaster) || 0\n};\n\n\nbuffer.push(power);\n\n\nif (buffer.length > 599) {\n    buffer.shift();\n}\n\n\nflow.set(\"buffer\", buffer);\n\n\nnode.warn(\"BUFFER SIZE = \" + buffer.length);\n\n\nif (buffer.length === 599) {\n\n\n    node.warn(\"BUFFER FULL\");\n\n\n    msg.payload = {\n        power: buffer\n    };\n\n\n    return msg;\n}\n\n\nreturn null;\n\n\n\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
