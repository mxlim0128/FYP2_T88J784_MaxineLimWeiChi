    {
        "id": "2883cbc6306dd88e",
        "type": "function",
        "z": "c2e9e564fd169a4f",
        "name": "Format for UI",
        "func": "const status = msg.payload.status || {};\nconst power = msg.payload.power || {};\n\n// Appliance status\nlet ui_status = {\n    lamp: \"OFF\",\n    kettle: \"OFF\",\n    toaster: \"OFF\",\n    laptop: \"OFF\"\n};\n\n// Update status\nfor (const appliance in status) {\n    if (status[appliance] == 1) {\n        ui_status[appliance] = \"ON\";\n    }\n}\n\n// Total detected power\nlet total_power = 0;\n\nfor (const appliance in power) {\n    total_power += Number(power[appliance]);\n}\n\nreturn [\n    { payload: ui_status.lamp },\n    { payload: ui_status.kettle },\n    { payload: ui_status.toaster },\n    { payload: ui_status.laptop },\n    { payload: total_power.toFixed(2) }\n];\n\n",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
