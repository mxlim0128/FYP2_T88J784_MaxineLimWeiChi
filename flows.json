    {
        "id": "ab6e2b9bdf6eb879",
        "type": "function",
        "z": "c2e9e564fd169a4f",
        "name": "Appliance Priority Logic",
        "func": "let totalPower = msg.original_payload?.total_power || 0;\n\n\nnode.warn(\"Total Power = \" + totalPower);\n\n\nif (totalPower > 2200) {\n\n\n    node.warn(\"OVERLOAD DETECTED\");\n\n\n    // First priority: Lamp\n    if (msg.payload.status.lamp == 1) {\n\n\n        node.warn(\"OVERLOAD -> Lamp OFF\");\n\n\n        msg.payload = {\n            lamp: \"OFF\"\n        };\n\n\n        return msg;\n    }\n\n\n    // Second priority: Laptop\n    if (msg.payload.status.laptop == 1) {\n\n\n        node.warn(\"OVERLOAD -> Laptop OFF\");\n\n\n        msg.payload = {\n            laptop: \"OFF\"\n        };\n\n\n        return msg;\n    }\n\n\n    node.warn(\"OVERLOAD BUT NO SHEDABLE LOAD FOUND\");\n}\n\n\n// No overload\nnode.warn(\"NORMAL OPERATION\");\n\n\nreturn null;\n\n\n\n\n\n\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 420,
        "wires": [
            [
                "ed5c660e2a6f562e",
                "def2912e95f0cef6"
