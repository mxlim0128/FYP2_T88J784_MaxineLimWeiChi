    {
        "id": "a9d524c582864782",
        "type": "function",
        "z": "c2e9e564fd169a4f",
        "name": "Format for InfluxDB",
        "func": "msg.payload = {\n    total_power: msg.original_payload?.total_power || 0,\n    voltage: msg.original_payload?.voltage || 0,\n    current: msg.original_payload?.current || 0,\n\n\n    lamp: msg.payload.status?.lamp || 0,\n    kettle: msg.payload.status?.kettle || 0,\n    toaster: msg.payload.status?.toaster || 0,\n    laptop: msg.payload.status?.laptop || 0,\n\n\n    lamp_power: msg.payload.power?.lamp || 0,\n    kettle_power: msg.payload.power?.kettle || 0,\n    toaster_power: msg.payload.power?.toaster || 0,\n    laptop_power: msg.payload.power?.laptop || 0,\n\n\n    relay_lamp: msg.original_payload?.relay_lamp || 0,\n    relay_laptop: msg.original_payload?.relay_laptop || 0,\n    relay_kettle: msg.original_payload?.relay_kettle || 0,\n    relay_toaster: msg.original_payload?.relay_toaster || 0,\n\n\n    baseline_power: 1500,\n\n\n    energy_saved_percent:\n        Math.max(\n            0,\n            ((2200 - (msg.original_payload?.total_power || 0)) / 2200) * 100\n        )\n\n};\n\n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
