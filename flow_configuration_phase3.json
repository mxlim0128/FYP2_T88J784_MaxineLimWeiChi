    {
        "id": "0b350b7017197537",
        "type": "function",
        "z": "5898543ddf3dd06a",
        "name": "Check Peak Hour & Decide",
        "func": "// Implementation of the simple automated control strategy (Page 24 of plan)\nvar currentHour = new Date().getHours();\nvar isPeakTime = (currentHour >= 16 && currentHour <= 21); // 4 PM - 9 PM Example\nvar HEATER_ON_THRESHOLD = 50.0; // Appliance is considered ON if above 50W\n\n// 1. Get Disaggregated Power for Heater\nvar heaterPower = parseFloat(msg.payload);\nvar heaterIsOn = (!isNaN(heaterPower) && heaterPower > HEATER_ON_THRESHOLD);\n\n// 2. Decision Logic\nif (heaterIsOn && isPeakTime) {\n    // DECISION: TURN OFF (Prioritize turning off during peak)\n    msg.payload = \"off\";\n    node.warn(\"Decision: TURNING HEATER OFF (Peak Time)\"); // Log the action\n    return msg; // Pass 'off' command to the next node\n} else {\n    // DECISION: DO NOTHING\n    return null; // Stop the flow\n}",
        "outputs": 1,
        "noerr": 0,
