    {
        "id": "596b213b251941e4",
        "type": "function",
        "z": "5898543ddf3dd06a",
        "name": "Format Aggregate Power for InfluxDB",
        "func": "// Parse the power string (e.g., \"1907.67\") into a float\nvar power = parseFloat(msg.payload);\n\n// Ensure it's a valid number and package it for InfluxDB\nif (!isNaN(power)) {\n    // InfluxDB expects an array of points. \n    // Measurement: 'aggregate_power'\n    // Field: 'value' (the power in Watts)\n    msg.payload = [\n        {\n            measurement: \"aggregate_power\",\n            fields: {\n                value: power\n            },\n            tags: {\n                device: \"mains\" // Optional tag for filtering\n            }\n        }\n    ];\n\n    msg.organization = \"nilm-org\";\n    msg.bucket = \"nilm-bucket\";\n    \n    return msg;\n}\nreturn null; // Stop the flow if the payload is not a number",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
